generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, citext]
}

model College {
  id             String   @id @default(uuid()) @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @updatedAt @db.Timestamptz
  is_synthetic   Boolean  @default(false)
  name           String   @db.VarChar(255)
  email_domains  String[]
  timezone       String   @default("Asia/Kolkata") @db.VarChar(64)

  users          User[]

  @@map("colleges")
}

model User {
  id                      String                  @id @default(uuid()) @db.Uuid
  created_at              DateTime                @default(now()) @db.Timestamptz
  updated_at              DateTime                @updatedAt @db.Timestamptz
  is_synthetic            Boolean                 @default(false)
  college_id              String                  @db.Uuid
  email                   String                  @db.VarChar(255)
  full_name               String                  @db.VarChar(100)
  phone_e164              String?                 @db.VarChar(20)
  status                  String                  @default("ACTIVE") @db.VarChar(20) // ACTIVE, SUSPENDED, DEACTIVATED
  deactivated_at          DateTime?               @db.Timestamptz
  last_seen_at            DateTime?               @db.Timestamptz

  college                 College                 @relation(fields: [college_id], references: [id])
  roles                   UserRole[]
  sessions                Session[]
  otp_challenges          OtpChallenge[]
  mfa_factors             MfaFactor[]
  recovery_codes          RecoveryCode[]
  student_profile         StudentProfile?
  driver_rosters          DriverRoster[]
  faculty_assignments     FacultyAssignment[]
  student_routes          StudentRoute[]
  shifts                  Shift[]
  attendance_records      AttendanceRecord[]
  leave_records           LeaveRecord[]
  absence_alerts          AbsenceAlert[]
  stop_requests           StopRequest[]
  stop_request_votes      StopRequestVote[]
  notifications           Notification[]
  notification_preferences NotificationPreference[]
  data_requests           DataRequest[]
  consents                Consent[]
  export_jobs             ExportJob[]
  push_tokens             PushToken[]

  @@unique([college_id, email])
  @@index([college_id])
  @@index([status])
  @@map("users")
}

model UserRole {
  id           String    @id @default(uuid()) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  is_synthetic Boolean   @default(false)
  user_id      String    @db.Uuid
  role         String    @db.VarChar(20) // STU, FAC, DRV, SEC, COR, TEC, MGT, SAD
  granted_by   String?   @db.Uuid
  granted_at   DateTime  @default(now()) @db.Timestamptz
  revoked_at   DateTime? @db.Timestamptz

  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([role])
  @@map("user_roles")
}

model Session {
  id                 String    @id @default(uuid()) @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @updatedAt @db.Timestamptz
  is_synthetic       Boolean   @default(false)
  user_id            String    @db.Uuid
  family_id          String    @db.Uuid
  refresh_token_hash String    @db.VarChar(128)
  device_label       String?   @db.VarChar(100)
  last_used_at       DateTime  @default(now()) @db.Timestamptz
  expires_at         DateTime  @db.Timestamptz
  revoked_at         DateTime? @db.Timestamptz

  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, revoked_at])
  @@index([family_id])
  @@map("sessions")
}

model OtpChallenge {
  id           String    @id @default(uuid()) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  is_synthetic Boolean   @default(false)
  user_id      String    @db.Uuid
  code_hmac    String    @db.VarChar(128)
  expires_at   DateTime  @db.Timestamptz
  attempts     Int       @default(0)
  consumed_at  DateTime? @db.Timestamptz

  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("otp_challenges")
}

model MfaFactor {
  id               String   @id @default(uuid()) @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @updatedAt @db.Timestamptz
  is_synthetic     Boolean  @default(false)
  user_id          String   @db.Uuid
  type             String   @default("TOTP") @db.VarChar(20)
  secret_encrypted String   @db.Text
  enrolled_at      DateTime @default(now()) @db.Timestamptz

  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, type])
  @@map("mfa_factors")
}

model RecoveryCode {
  id           String    @id @default(uuid()) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  is_synthetic Boolean   @default(false)
  user_id      String    @db.Uuid
  code_hash    String    @db.VarChar(255) // Argon2id hash
  used_at      DateTime? @db.Timestamptz

  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("recovery_codes")
}

model StudentProfile {
  id                         String   @id @default(uuid()) @db.Uuid
  created_at                 DateTime @default(now()) @db.Timestamptz
  updated_at                 DateTime @updatedAt @db.Timestamptz
  is_synthetic               Boolean  @default(false)
  user_id                    String   @unique @db.Uuid
  department                 String   @db.VarChar(100)
  year_of_study              Int
  date_of_birth_encrypted    String   @db.Text
  guardian_contact_encrypted String?  @db.Text
  approach_threshold_min     Int      @default(5)

  user                       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model Bus {
  id                  String               @id @default(uuid()) @db.Uuid
  created_at          DateTime             @default(now()) @db.Timestamptz
  updated_at          DateTime             @updatedAt @db.Timestamptz
  is_synthetic        Boolean              @default(false)
  bus_number          String               @unique @db.VarChar(30)
  registration_number String               @unique @db.VarChar(30)
  capacity            Int
  status              String               @default("ACTIVE") @db.VarChar(20) // ACTIVE, MAINTENANCE, RETIRED
  default_mode        String               @default("AUTO") @db.VarChar(20)   // AUTO, MANUAL_HW, MANUAL_PHONE
  insurance_expiry    DateTime             @db.Date
  fitness_expiry      DateTime             @db.Date
  pollution_expiry    DateTime             @db.Date
  permit_expiry       DateTime             @db.Date

  device_links        DeviceLink[]
  driver_rosters      DriverRoster[]
  faculty_assignments FacultyAssignment[]
  route_bus_assignments RouteBusAssignment[]
  shifts              Shift[]
  trips               Trip[]
  bus_state           BusState?
  source_switches     SourceSwitch[]
  sos_incidents       SosIncident[]
  maintenance_tickets MaintenanceTicket[]

  @@map("buses")
}

model Device {
  id                 String             @id @default(uuid()) @db.Uuid
  created_at         DateTime           @default(now()) @db.Timestamptz
  updated_at         DateTime           @updatedAt @db.Timestamptz
  is_synthetic       Boolean            @default(false)
  device_id          String             @unique @db.VarChar(30) // HW_nnn or HW_nnnn
  serial_number      String             @db.VarChar(100)
  imei               String             @unique @db.VarChar(15)
  iccid              String             @db.VarChar(20)
  status             String             @default("PROVISIONED") @db.VarChar(20) // PROVISIONED, ACTIVE, REVOKED, RETIRED, BENCH
  fw_version         String             @default("1.0.0") @db.VarChar(30)
  module_fw_version  String?            @db.VarChar(50)
  schema_version     Int                @default(1)
  vehicle_class      String             @default("V12") @db.VarChar(10) // V12, V24
  first_used_at      DateTime?          @db.Timestamptz
  retired_at         DateTime?          @db.Timestamptz

  tokens             DeviceToken[]
  device_links       DeviceLink[]
  health             DeviceHealth?
  device_events      DeviceEvent[]
  maintenance_tickets MaintenanceTicket[]

  @@map("devices")
}

model DeviceToken {
  id            String    @id @default(uuid()) @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @updatedAt @db.Timestamptz
  is_synthetic  Boolean   @default(false)
  device_id     String    @db.VarChar(30)
  key_version   String    @db.VarChar(20)
  token_hash    String    @db.VarChar(128)
  status        String    @default("PENDING") @db.VarChar(20) // PENDING, ACTIVE, REVOKED
  first_used_at DateTime? @db.Timestamptz
  revoked_at    DateTime? @db.Timestamptz
  expires_at    DateTime? @db.Timestamptz

  device        Device    @relation(fields: [device_id], references: [device_id], onDelete: Cascade)

  @@unique([key_version, token_hash])
  @@index([device_id])
  @@map("device_tokens")
}

model DeviceLink {
  id           String    @id @default(uuid()) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  is_synthetic Boolean   @default(false)
  device_id    String    @db.VarChar(30)
  bus_id       String    @db.Uuid
  valid_from   DateTime  @default(now()) @db.Timestamptz
  valid_to     DateTime? @db.Timestamptz
  set_by       String    @db.Uuid

  device       Device    @relation(fields: [device_id], references: [device_id])
  bus          Bus       @relation(fields: [bus_id], references: [id])

  @@index([device_id])
  @@index([bus_id])
  @@map("device_links")
}

model DeviceHealth {
  device_id          String    @id @db.VarChar(30)
  last_heartbeat_at  DateTime? @db.Timestamptz
  last_fix_at        DateTime? @db.Timestamptz
  state              String    @default("OFFLINE") @db.VarChar(20) // ONLINE, DELAYED, OFFLINE
  fw_version         String?   @db.VarChar(30)
  vehicle_battery_mv Int?
  device_battery_mv  Int?
  signal_rssi_dbm    Int?
  sim_status         String?   @db.VarChar(30)
  network_status     String?   @db.VarChar(30)
  gps_status         String?   @db.VarChar(30)
  buffer_bytes       Int?
  ignition           String?   @db.VarChar(10)

  device             Device    @relation(fields: [device_id], references: [device_id], onDelete: Cascade)

  @@map("device_health")
}

model DeviceEvent {
  id           String    @id @default(uuid()) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  is_synthetic Boolean   @default(false)
  device_id    String    @db.VarChar(30)
  bus_id       String?   @db.Uuid
  type         String    @db.VarChar(50)
  boot_id      String    @db.VarChar(32)
  event_seq    Int
  occurred_at  DateTime? @db.Timestamptz
  received_at  DateTime  @default(now()) @db.Timestamptz
  payload      Json      @db.JsonB
  status       String    @default("RECORDED") @db.VarChar(20) // RECORDED, PROCESSED, IGNORED
  dedupe_key   String    @unique @db.VarChar(128)

  device       Device    @relation(fields: [device_id], references: [device_id])

  @@index([bus_id, received_at])
  @@map("device_events")
}

model FirmwareRelease {
  id           String            @id @default(uuid()) @db.Uuid
  created_at   DateTime          @default(now()) @db.Timestamptz
  updated_at   DateTime          @updatedAt @db.Timestamptz
  is_synthetic Boolean           @default(false)
  version      String            @unique @db.VarChar(30)
  sha256       String            @db.VarChar(64)
  size_bytes   Int
  storage_key  String            @db.VarChar(255)
  channel      String            @default("STABLE") @db.VarChar(20) // STABLE, BETA
  status       String            @default("DRAFT") @db.VarChar(20)  // DRAFT, ROLLING_OUT, COMPLETE, WITHDRAWN
  released_at  DateTime?         @db.Timestamptz

  rollouts     FirmwareRollout[]

  @@map("firmware_releases")
}

model FirmwareRollout {
  id            String          @id @default(uuid()) @db.Uuid
  created_at    DateTime        @default(now()) @db.Timestamptz
  updated_at    DateTime        @updatedAt @db.Timestamptz
  is_synthetic  Boolean         @default(false)
  release_id    String          @db.Uuid
  step          String          @db.VarChar(20) // CANARY, PERCENT_25, FULL
  status        String          @default("IN_PROGRESS") @db.VarChar(20)
  started_at    DateTime        @default(now()) @db.Timestamptz
  paused_reason String?         @db.Text

  release       FirmwareRelease @relation(fields: [release_id], references: [id])

  @@index([release_id])
  @@map("firmware_rollouts")
}

model MaintenanceTicket {
  id              String    @id @default(uuid()) @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  is_synthetic    Boolean   @default(false)
  bus_id          String?   @db.Uuid
  device_id       String?   @db.VarChar(30)
  source          String    @db.VarChar(30) // DRIVER_REPORT, SYSTEM_ALERT, MANUAL
  category        String    @db.VarChar(50)
  status          String    @default("OPEN") @db.VarChar(20) // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  opened_by       String    @db.Uuid
  assigned_to     String?   @db.Uuid
  description     String    @db.VarChar(500)
  resolution_note String?   @db.Text
  opened_at       DateTime  @default(now()) @db.Timestamptz
  closed_at       DateTime? @db.Timestamptz

  bus             Bus?      @relation(fields: [bus_id], references: [id])
  device          Device?   @relation(fields: [device_id], references: [device_id])

  @@index([status, opened_at])
  @@map("maintenance_tickets")
}

model Stop {
  id           String      @id @default(uuid()) @db.Uuid
  created_at   DateTime    @default(now()) @db.Timestamptz
  updated_at   DateTime    @updatedAt @db.Timestamptz
  is_synthetic Boolean     @default(false)
  name         String      @db.VarChar(60)
  latitude     Float
  longitude    Float
  radius_m     Float       @default(50)
  status       String      @default("ACTIVE") @db.VarChar(20)
  created_by   String      @db.Uuid

  route_stops  RouteStop[]

  @@map("stops")
}

model Route {
  id                    String                @id @default(uuid()) @db.Uuid
  created_at            DateTime              @default(now()) @db.Timestamptz
  updated_at            DateTime              @updatedAt @db.Timestamptz
  is_synthetic          Boolean               @default(false)
  code                  String                @unique @db.VarChar(30)
  name                  String                @db.VarChar(100)
  status                String                @default("ACTIVE") @db.VarChar(20)

  route_stops           RouteStop[]
  route_geometries      RouteGeometry[]
  route_bus_assignments RouteBusAssignment[]
  timetables            Timetable[]
  student_routes        StudentRoute[]
  trips                 Trip[]
  stop_requests         StopRequest[]

  @@map("routes")
}

model RouteStop {
  id           String    @id @default(uuid()) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  is_synthetic Boolean   @default(false)
  route_id     String    @db.Uuid
  stop_id      String    @db.Uuid
  sequence     Int
  valid_from   DateTime  @default(now()) @db.Timestamptz
  valid_to     DateTime? @db.Timestamptz

  route        Route     @relation(fields: [route_id], references: [id], onDelete: Cascade)
  stop         Stop      @relation(fields: [stop_id], references: [id], onDelete: Cascade)

  @@index([stop_id])
  @@map("route_stops")
}

model RouteGeometry {
  id           String    @id @default(uuid()) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  is_synthetic Boolean   @default(false)
  route_id     String    @db.Uuid
  version      Int
  geojson_line Json      @db.JsonB
  valid_from   DateTime  @default(now()) @db.Timestamptz
  valid_to     DateTime? @db.Timestamptz

  route        Route     @relation(fields: [route_id], references: [id], onDelete: Cascade)

  @@unique([route_id, version])
  @@map("route_geometries")
}

model RouteBusAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  is_synthetic Boolean   @default(false)
  route_id     String    @db.Uuid
  bus_id       String    @db.Uuid
  trip_type    String    @db.VarChar(20) // MORNING, AFTERNOON
  weekday_mask Int       // 7-bit binary representation of days
  valid_from   DateTime  @default(now()) @db.Timestamptz
  valid_to     DateTime? @db.Timestamptz

  route        Route     @relation(fields: [route_id], references: [id])
  bus          Bus       @relation(fields: [bus_id], references: [id])

  @@index([route_id])
  @@index([bus_id])
  @@map("route_bus_assignments")
}

model Timetable {
  id             String    @id @default(uuid()) @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamptz
  updated_at     DateTime  @updatedAt @db.Timestamptz
  is_synthetic   Boolean   @default(false)
  route_id       String    @db.Uuid
  trip_type      String    @db.VarChar(20) // MORNING, AFTERNOON
  departure_time String    @db.VarChar(5)  // HH:MM campus time
  weekday_mask   Int
  valid_from     DateTime  @default(now()) @db.Timestamptz
  valid_to       DateTime? @db.Timestamptz

  route          Route     @relation(fields: [route_id], references: [id], onDelete: Cascade)

  @@index([route_id, trip_type])
  @@map("timetables")
}

model Holiday {
  id           String   @id @default(uuid()) @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz
  is_synthetic Boolean  @default(false)
  holiday_date DateTime @unique @db.Date
  name         String   @db.VarChar(100)

  @@map("holidays")
}

model DriverRoster {
  id           String    @id @default(uuid()) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  is_synthetic Boolean   @default(false)
  bus_id       String    @db.Uuid
  driver_id    String    @db.Uuid
  valid_from   DateTime  @default(now()) @db.Timestamptz
  valid_to     DateTime? @db.Timestamptz

  bus          Bus       @relation(fields: [bus_id], references: [id])
  driver       User      @relation(fields: [driver_id], references: [id])

  @@index([bus_id])
  @@index([driver_id])
  @@map("driver_roster")
}

model FacultyAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  is_synthetic Boolean   @default(false)
  bus_id       String    @db.Uuid
  faculty_id   String    @db.Uuid
  is_primary   Boolean   @default(false)
  valid_from   DateTime  @default(now()) @db.Timestamptz
  valid_to     DateTime? @db.Timestamptz

  bus          Bus       @relation(fields: [bus_id], references: [id])
  faculty      User      @relation(fields: [faculty_id], references: [id])

  @@index([bus_id])
  @@index([faculty_id])
  @@map("faculty_assignments")
}

model StudentRoute {
  id               String    @id @default(uuid()) @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @updatedAt @db.Timestamptz
  is_synthetic     Boolean   @default(false)
  student_id       String    @db.Uuid
  route_id         String    @db.Uuid
  trip_type        String    @db.VarChar(20) // MORNING, AFTERNOON
  boarding_stop_id String    @db.Uuid
  valid_from       DateTime  @default(now()) @db.Timestamptz
  valid_to         DateTime? @db.Timestamptz

  student          User      @relation(fields: [student_id], references: [id])
  route            Route     @relation(fields: [route_id], references: [id])

  @@index([student_id])
  @@index([route_id])
  @@map("student_routes")
}

model Shift {
  id              String    @id @default(uuid()) @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  is_synthetic    Boolean   @default(false)
  bus_id          String    @db.Uuid
  driver_id       String    @db.Uuid
  trip_id         String?   @db.Uuid
  phone_device_ref String?  @db.VarChar(100)
  mode_at_start   String    @default("AUTO") @db.VarChar(20)
  started_at      DateTime  @default(now()) @db.Timestamptz
  ended_at        DateTime? @db.Timestamptz
  end_reason      String?   @db.VarChar(30) // MANUAL, AUTO_IDLE, ADMIN, TIMEOUT
  status          String    @default("ACTIVE") @db.VarChar(20) // ACTIVE, ENDED

  bus             Bus       @relation(fields: [bus_id], references: [id])
  driver          User      @relation(fields: [driver_id], references: [id])
  trips           Trip[]

  @@index([bus_id])
  @@index([driver_id])
  @@map("shifts")
}

model Trip {
  id                  String             @id @default(uuid()) @db.Uuid
  created_at          DateTime           @default(now()) @db.Timestamptz
  updated_at          DateTime           @updatedAt @db.Timestamptz
  is_synthetic        Boolean            @default(false)
  route_id            String             @db.Uuid
  bus_id              String             @db.Uuid
  shift_id            String?            @db.Uuid
  trip_type           String             @db.VarChar(20) // MORNING, AFTERNOON
  service_date        DateTime           @db.Date
  scheduled_departure DateTime           @db.Timestamptz
  actual_departure    DateTime?          @db.Timestamptz
  ended_at            DateTime?          @db.Timestamptz
  status              String             @default("SCHEDULED") @db.VarChar(20) // SCHEDULED, ACTIVE, COMPLETED, CANCELLED
  route_geometry_id   String?            @db.Uuid

  route               Route              @relation(fields: [route_id], references: [id])
  bus                 Bus                @relation(fields: [bus_id], references: [id])
  shift               Shift?             @relation(fields: [shift_id], references: [id])
  attendance_records  AttendanceRecord[]
  stop_events         StopEvent[]
  sos_incidents       SosIncident[]

  @@unique([route_id, bus_id, service_date, trip_type])
  @@index([service_date])
  @@map("trips")
}

model BusState {
  bus_id              String    @id @db.Uuid
  state               String    @default("NOT_RUNNING") @db.VarChar(20) // NOT_RUNNING, LIVE, STALE, UNAVAILABLE, NO_HARDWARE
  active_source       String    @default("NONE") @db.VarChar(10)       // HW, PHONE, NONE
  mode                String    @default("AUTO") @db.VarChar(20)       // AUTO, MANUAL_HW, MANUAL_PHONE
  last_hw_valid_at    DateTime? @db.Timestamptz
  last_phone_valid_at DateTime? @db.Timestamptz
  last_lat            Float?
  last_lng            Float?
  last_speed_kmh      Float?
  last_heading_deg    Float?
  consecutive_hw_valid Int      @default(0)
  last_switch_at      DateTime? @db.Timestamptz
  route_version       Int       @default(1)
  version             Int       @default(1)

  bus                 Bus       @relation(fields: [bus_id], references: [id], onDelete: Cascade)

  @@map("bus_state")
}

model SourceSwitch {
  id           String   @id @default(uuid()) @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz
  is_synthetic Boolean  @default(false)
  bus_id       String   @db.Uuid
  from_source  String   @db.VarChar(10) // HW, PHONE, NONE
  to_source    String   @db.VarChar(10) // HW, PHONE, NONE
  reason_code  String   @db.VarChar(50)
  actor_type   String   @db.VarChar(20) // SYSTEM, DRIVER, ADMIN
  actor_id     String?  @db.Uuid
  note         String?  @db.VarChar(140)
  at           DateTime @default(now()) @db.Timestamptz

  bus          Bus      @relation(fields: [bus_id], references: [id])

  @@index([bus_id, at])
  @@map("source_switches")
}

model StopEvent {
  id           String   @id @default(uuid()) @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz
  is_synthetic Boolean  @default(false)
  trip_id      String   @db.Uuid
  stop_id      String   @db.Uuid
  event        String   @db.VarChar(20) // ARRIVED, DEPARTED
  at           DateTime @default(now()) @db.Timestamptz
  method       String   @default("AUTO") @db.VarChar(20) // AUTO, MANUAL
  source       String?  @db.VarChar(20)

  trip         Trip     @relation(fields: [trip_id], references: [id])

  @@index([trip_id, at])
  @@map("stop_events")
}

model AttendanceRecord {
  id               String    @id @default(uuid()) @db.Uuid
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @updatedAt @db.Timestamptz
  is_synthetic     Boolean   @default(false)
  trip_id          String    @db.Uuid
  student_id       String    @db.Uuid
  status           String    @default("EXPECTED") @db.VarChar(20) // EXPECTED, BOARDED, LATE_BOARDED, ABSENT, ON_LEAVE, MANUAL_CHECKIN, FLAGGED_GUEST, BOARDED_LATE
  boarded_at       DateTime? @db.Timestamptz
  method           String?   @db.VarChar(20) // QR, DRIVER, RFID
  marked_by        String?   @db.Uuid
  boarding_stop_id String?   @db.Uuid

  trip             Trip      @relation(fields: [trip_id], references: [id])
  student          User      @relation(fields: [student_id], references: [id])

  @@unique([trip_id, student_id])
  @@index([student_id])
  @@map("attendance_records")
}

model LeaveRecord {
  id              String    @id @default(uuid()) @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  is_synthetic    Boolean   @default(false)
  student_id      String    @db.Uuid
  service_date    DateTime  @db.Date
  trip_type       String    @db.VarChar(20) // MORNING, AFTERNOON
  reason_category String    @db.VarChar(20) // PERSONAL, ACADEMIC, OTHER
  created_by      String    @db.Uuid
  cancelled_at    DateTime? @db.Timestamptz

  student         User      @relation(fields: [student_id], references: [id])

  @@index([student_id, service_date])
  @@map("leave_records")
}

model AbsenceAlert {
  id                String    @id @default(uuid()) @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @updatedAt @db.Timestamptz
  is_synthetic      Boolean   @default(false)
  student_id        String    @db.Uuid
  service_date      DateTime  @db.Date
  morning_trip_id   String    @db.Uuid
  afternoon_trip_id String    @db.Uuid
  alerted_at        DateTime  @default(now()) @db.Timestamptz
  status            String    @default("OPEN") @db.VarChar(20) // OPEN, ACKNOWLEDGED, BOARDED_LATE, CLOSED
  acknowledged_by   String?   @db.Uuid
  note              String?   @db.Text

  student           User      @relation(fields: [student_id], references: [id])

  @@unique([student_id, service_date])
  @@map("absence_alerts")
}

model SosIncident {
  id                   String     @id @default(uuid()) @db.Uuid
  created_at           DateTime   @default(now()) @db.Timestamptz
  updated_at           DateTime   @updatedAt @db.Timestamptz
  is_synthetic         Boolean    @default(false)
  bus_id               String?    @db.Uuid
  trip_id              String?    @db.Uuid
  category             String     @default("UNKNOWN") @db.VarChar(20) // EMERGENCY, MEDICAL, BREAKDOWN, OTHER, UNKNOWN
  first_trigger_type   String     @db.VarChar(30) // DRIVER_APP, HW_BUTTON, STUDENT_APP, FACULTY_APP, SECURITY_APP
  first_triggered_at   DateTime   @default(now()) @db.Timestamptz
  device_triggered_at  DateTime?  @db.Timestamptz
  received_at          DateTime   @default(now()) @db.Timestamptz
  status               String     @default("OPEN") @db.VarChar(20) // OPEN, RESPONDING, RESOLVED, CANCELLED, DRILL_CLOSED
  current_tier         Int        @default(0)
  is_drill             Boolean    @default(false)
  resolved_at          DateTime?  @db.Timestamptz
  resolved_by          String?    @db.Uuid
  resolution_note      String?    @db.VarChar(500)

  bus                  Bus?       @relation(fields: [bus_id], references: [id])
  trip                 Trip?      @relation(fields: [trip_id], references: [id])
  events               SosEvent[]

  @@index([status, received_at])
  @@map("sos_incidents")
}

model SosEvent {
  id           String      @id @default(uuid()) @db.Uuid
  created_at   DateTime    @default(now()) @db.Timestamptz
  updated_at   DateTime    @updatedAt @db.Timestamptz
  is_synthetic Boolean     @default(false)
  incident_id  String      @db.Uuid
  type         String      @db.VarChar(30) // TRIGGERED, JOINED, DELIVERED, ACKNOWLEDGED, RESPONDING, ESCALATED, CANCELLED, RESOLVED, NOTE, DEVICE_RECEIVED
  actor_id     String?     @db.Uuid
  at           DateTime    @default(now()) @db.Timestamptz
  detail       Json        @db.JsonB

  incident     SosIncident @relation(fields: [incident_id], references: [id], onDelete: Cascade)

  @@index([incident_id, at])
  @@map("sos_events")
}

model StopRequest {
  id               String            @id @default(uuid()) @db.Uuid
  created_at       DateTime          @default(now()) @db.Timestamptz
  updated_at       DateTime          @updatedAt @db.Timestamptz
  is_synthetic     Boolean           @default(false)
  requested_by     String            @db.Uuid
  proposed_name    String            @db.VarChar(60)
  latitude         Float
  longitude        Float
  route_id         String            @db.Uuid
  status           String            @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED, MERGED
  merged_into_id   String?           @db.Uuid
  vote_count       Int               @default(1)
  reviewed_by      String?           @db.Uuid
  review_note      String?           @db.Text
  approved_stop_id String?           @db.Uuid
  effective_from   DateTime?         @db.Date

  requester        User              @relation(fields: [requested_by], references: [id])
  route            Route             @relation(fields: [route_id], references: [id])
  votes            StopRequestVote[]

  @@index([route_id, status])
  @@map("stop_requests")
}

model StopRequestVote {
  id           String      @id @default(uuid()) @db.Uuid
  created_at   DateTime    @default(now()) @db.Timestamptz
  updated_at   DateTime    @updatedAt @db.Timestamptz
  is_synthetic Boolean     @default(false)
  request_id   String      @db.Uuid
  student_id   String      @db.Uuid

  request      StopRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  student      User        @relation(fields: [student_id], references: [id])

  @@unique([request_id, student_id])
  @@map("stop_request_votes")
}

model Notification {
  id           String                 @id @default(uuid()) @db.Uuid
  created_at   DateTime               @default(now()) @db.Timestamptz
  updated_at   DateTime               @updatedAt @db.Timestamptz
  is_synthetic Boolean                @default(false)
  recipient_id String                 @db.Uuid
  category     String                 @db.VarChar(20) // SAFETY, ATTENDANCE, TRIP, ADMIN, SYSTEM
  title        String                 @db.VarChar(120)
  body         String                 @db.Text
  data         Json                   @db.JsonB
  read_at      DateTime?              @db.Timestamptz

  recipient    User                   @relation(fields: [recipient_id], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@index([recipient_id, created_at])
  @@map("notifications")
}

model NotificationDelivery {
  id              String       @id @default(uuid()) @db.Uuid
  created_at      DateTime     @default(now()) @db.Timestamptz
  updated_at      DateTime     @updatedAt @db.Timestamptz
  is_synthetic    Boolean      @default(false)
  notification_id String       @db.Uuid
  channel         String       @db.VarChar(20) // PUSH, SMS, EMAIL, IN_APP
  status          String       @default("QUEUED") @db.VarChar(20) // QUEUED, SENT, DELIVERED, FAILED, SUPPRESSED, DEAD
  attempts        Int          @default(0)
  next_attempt_at DateTime?    @db.Timestamptz
  provider_ref    String?      @db.VarChar(255)
  last_error      String?      @db.Text

  notification    Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)

  @@index([status, next_attempt_at])
  @@map("notification_deliveries")
}

model NotificationPreference {
  id           String   @id @default(uuid()) @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz
  is_synthetic Boolean  @default(false)
  user_id      String   @db.Uuid
  category     String   @db.VarChar(20) // SAFETY, ATTENDANCE, TRIP, ADMIN, SYSTEM
  channel      String   @db.VarChar(20) // PUSH, SMS, EMAIL, IN_APP
  enabled      Boolean  @default(true)

  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category, channel])
  @@map("notification_preferences")
}

model Announcement {
  id           String    @id @default(uuid()) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  is_synthetic Boolean   @default(false)
  title        String    @db.VarChar(120)
  body         String    @db.VarChar(1000)
  scope_type   String    @db.VarChar(20) // ALL, ROUTE, BUS
  scope_id     String?   @db.VarChar(64)
  created_by   String    @db.Uuid
  published_at DateTime  @default(now()) @db.Timestamptz
  expires_at   DateTime  @db.Timestamptz

  @@map("announcements")
}

model Setting {
  key        String   @id @db.VarChar(100)
  value      Json     @db.JsonB
  updated_by String   @db.Uuid
  reason     String   @db.VarChar(200)
  updated_at DateTime @updatedAt @db.Timestamptz

  @@map("settings")
}

model FeatureFlag {
  key        String   @id @db.VarChar(100)
  enabled    Boolean  @default(false)
  scope      String   @default("GLOBAL") @db.VarChar(50)
  updated_by String   @db.Uuid
  updated_at DateTime @updatedAt @db.Timestamptz

  @@map("feature_flags")
}

model SmsTemplate {
  id                     String   @id @default(uuid()) @db.Uuid
  created_at             DateTime @default(now()) @db.Timestamptz
  updated_at             DateTime @updatedAt @db.Timestamptz
  is_synthetic           Boolean  @default(false)
  purpose                String   @unique @db.VarChar(100)
  dlt_template_id        String   @db.VarChar(100)
  body_with_placeholders String   @db.Text
  approved_at            DateTime @default(now()) @db.Timestamptz

  @@map("sms_templates")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actor_id    String?  @db.Uuid
  actor_role  String?  @db.VarChar(20)
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(50)
  entity_id   String?  @db.VarChar(64)
  before      Json?    @db.JsonB
  after       Json?    @db.JsonB
  ip          String?  @db.VarChar(45)
  user_agent  String?  @db.VarChar(255)
  request_id  String?  @db.VarChar(64)
  at          DateTime @default(now()) @db.Timestamptz

  @@index([entity_type, entity_id, at])
  @@map("audit_logs")
}

model DataRequest {
  id           String    @id @default(uuid()) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  is_synthetic Boolean   @default(false)
  user_id      String    @db.Uuid
  type         String    @db.VarChar(30) // EXPORT, CORRECTION, DELETION, WITHDRAW_CONSENT
  status       String    @default("RECEIVED") @db.VarChar(30) // RECEIVED, IN_PROGRESS, COMPLETED, REJECTED_WITH_REASON
  received_at  DateTime  @default(now()) @db.Timestamptz
  due_at       DateTime  @db.Timestamptz
  completed_at DateTime? @db.Timestamptz
  handled_by   String?   @db.Uuid

  user         User      @relation(fields: [user_id], references: [id])

  @@index([status, due_at])
  @@map("data_requests")
}

model Consent {
  id                 String    @id @default(uuid()) @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @updatedAt @db.Timestamptz
  is_synthetic       Boolean   @default(false)
  user_id            String    @db.Uuid
  purpose            String    @db.VarChar(100)
  notice_version_id  String    @db.Uuid
  granted_by_user_id String?   @db.Uuid // Nullable if self
  granted_at         DateTime  @default(now()) @db.Timestamptz
  withdrawn_at       DateTime? @db.Timestamptz

  user               User      @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("consents")
}

model NoticeVersion {
  id             String   @id @default(uuid()) @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz
  updated_at     DateTime @updatedAt @db.Timestamptz
  is_synthetic   Boolean  @default(false)
  version        String   @unique @db.VarChar(30)
  text_url       String   @db.Text
  effective_from DateTime @default(now()) @db.Timestamptz

  @@map("notice_versions")
}

model ExportJob {
  id           String    @id @default(uuid()) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  is_synthetic Boolean   @default(false)
  requested_by String    @db.Uuid
  type         String    @db.VarChar(50)
  filters      Json      @db.JsonB
  status       String    @default("QUEUED") @db.VarChar(20) // QUEUED, RUNNING, READY, FAILED, EXPIRED
  storage_key  String?   @db.VarChar(255)
  row_count    Int?
  expires_at   DateTime? @db.Timestamptz

  user         User      @relation(fields: [requested_by], references: [id])

  @@map("export_jobs")
}

model PushToken {
  id              String    @id @default(uuid()) @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  is_synthetic    Boolean   @default(false)
  user_id         String    @db.Uuid
  install_id      String    @db.VarChar(128)
  token_encrypted String    @db.Text
  platform        String    @db.VarChar(20) // ANDROID, IOS
  last_seen_at    DateTime  @default(now()) @db.Timestamptz
  revoked_at      DateTime? @db.Timestamptz

  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, install_id])
  @@index([user_id])
  @@map("push_tokens")
}

model RateCounter {
  key          String   @id @db.VarChar(128)
  window_start DateTime @db.Timestamptz
  count        Int      @default(0)

  @@map("rate_counters")
}

model IdempotencyKey {
  user_id      String   @db.Uuid
  key          String   @db.VarChar(128)
  request_hash String   @db.VarChar(64)
  response     Json     @db.JsonB
  status_code  Int
  expires_at   DateTime @db.Timestamptz

  @@id([user_id, key])
  @@map("idempotency_keys")
}

model Outbox {
  id           String    @id @default(uuid()) @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz
  updated_at   DateTime  @updatedAt @db.Timestamptz
  is_synthetic Boolean   @default(false)
  kind         String    @db.VarChar(50)
  payload      Json      @db.JsonB
  status       String    @default("PENDING") @db.VarChar(20) // PENDING, DONE, FAILED
  attempts     Int       @default(0)
  available_at DateTime  @default(now()) @db.Timestamptz
  locked_at    DateTime? @db.Timestamptz

  @@index([status, available_at])
  @@map("outbox")
}
