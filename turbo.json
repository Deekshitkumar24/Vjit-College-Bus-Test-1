{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "lint:fix": {},
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "test:int": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:contract": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e:web": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e:mobile": {
      "cache": false
    },
    "test:a11y": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
