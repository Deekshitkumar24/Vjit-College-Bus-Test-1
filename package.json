{
  "name": "college-bus-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise-grade College Bus Tracker platform",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && prettier --check \"packages/**/*.{ts,tsx,js,json,md}\" \"services/**/*.{ts,tsx,js,json,md}\" \"scripts/**/*.{ts,tsx,js,json,md}\" \"docs/**/*.{ts,tsx,js,json,md}\"",
    "lint:fix": "turbo run lint:fix && prettier --write \"packages/**/*.{ts,tsx,js,json,md}\" \"services/**/*.{ts,tsx,js,json,md}\" \"scripts/**/*.{ts,tsx,js,json,md}\" \"docs/**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test:unit",
    "test:int": "turbo run test:int",
    "test:rls": "turbo run test:rls",
    "test:contract": "turbo run test:contract",
    "test:e2e:web": "turbo run test:e2e:web",
    "test:e2e:mobile": "turbo run test:e2e:mobile",
    "test:security": "tsx scripts/test-security.ts",
    "test:a11y": "turbo run test:a11y",
    "load:test": "k6 run tests/load/scenarios.js",
    "db:migrate": "pnpm --filter @collegebus/db db:migrate",
    "db:seed:config": "pnpm --filter @collegebus/db db:seed:config",
    "db:purge-synthetic": "tsx scripts/purge-synthetic.ts",
    "sim:start": "pnpm --filter @collegebus/simulator start",
    "verify:no-mock": "tsx scripts/verify-no-mock.ts",
    "verify:prod-clean": "tsx scripts/verify-prod-clean.ts",
    "verify:routes-auth": "tsx scripts/verify-routes-auth.ts",
    "verify:migrations": "tsx scripts/check-migrations.ts",
    "security:scan": "pnpm audit --prod --audit-level=high",
    "check:readiness": "tsx scripts/readiness/check.ts"
  },

  "devDependencies": {
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-no-secrets": "^1.0.2",
    "eslint-plugin-security": "^3.0.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "turbo": "^2.1.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "^4.3.2",
      "path-to-regexp": "^0.1.12",
      "lodash": "^4.18.0",
      "multer": "^2.3.0"
    }
  }
}
